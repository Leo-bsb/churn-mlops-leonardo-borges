# Caches e ambiente local nunca entram na imagem.
**/__pycache__/
**/*.pyc
.pytest_cache/
.ruff_cache/
.venv/
.env

# Metadados de VCS/versionamento: a imagem é construída a partir do contexto
# copiado, não precisa de histórico nem de cache do DVC.
.git/
.github/
.dvc/
dvc.yaml

# Artefatos de ML locais (os runs vivem fora da imagem).
mlflow.db
mlflow/
mlruns/
mlartifacts/

# Dados de treino NUNCA entram na imagem da API (Enc. 5): a inferência só
# precisa do modelo. O treino recebe ./data por volume (ver compose.yml).
data/

# Não usados no runtime da API (os testes rodam no CI).
tests/
docs/

# Da pasta artifacts/ só entram o modelo da API e o cartão de métricas.
artifacts/*
!artifacts/churn_model.joblib
!artifacts/model_metrics.json

# web/ NÃO é ignorado: o frontend entra na imagem e é servido em GET /.
