# ---- Ambiente local -------------------------------------------------------
.venv/
__pycache__/
*.pyc
.env
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store

# ---- Dados ----------------------------------------------------------------
# `data/churn.csv` É versionado no Git de propósito (~1 MB): assim o clone é
# auto-suficiente — `uv sync` + `dvc repro` funcionam sem nenhum remote DVC.
# Em um projeto com dados maiores, o fluxo canônico seria
# `dvc add data/churn.csv` + remote compartilhado (S3, Drive, DagsHub...),
# deixando só o ponteiro `data/churn.csv.dvc` no Git.
# O `dvc.yaml` descreve o pipeline reproduzível independentemente disso.

# ---- DVC ------------------------------------------------------------------
/.dvc/cache/
/.dvc/tmp/
/.dvc/config.local

# ---- MLflow (Bloco 2) -----------------------------------------------------
# Backend sqlite + artefatos locais: nunca vão para o Git.
mlflow.db
mlflow/
mlruns/
mlartifacts/

# ---- Artefatos de treino --------------------------------------------------
# O .pkl é saída do stage `treino` do DVC (regenerado por `dvc repro`).
# Versionados no Git: artifacts/churn_model.joblib (consumido pela API) e
# artifacts/model_metrics.json (cartão do modelo exibido em /model-info).
artifacts/*.pkl

*.log
