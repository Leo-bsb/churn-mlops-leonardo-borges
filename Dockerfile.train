# Imagem de TREINO do pipeline (Encontro 3). O dado NÃO é copiado para a
# imagem (Enc. 5): entra por volume (ver compose.yml) ou por `dvc pull`.
#
# Mesma base Python da imagem da API (3.14) e do CI: o `uv.lock` é resolvido
# para essa versão, então divergir aqui só cria surpresa.
FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim
ENV UV_LINK_MODE=copy \
    UV_NO_PROGRESS=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

# deps antes do código: mudar um .py não reinstala o mundo
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-install-project

COPY src/ ./src/
RUN uv sync --frozen

# O stage `treino` do dvc.yaml roda exatamente este comando.
CMD ["uv", "run", "python", "-m", "churn.model"]
